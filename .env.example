# Copy to .env for local development. `shopify app dev` injects SHOPIFY_API_KEY,
# SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES automatically.

DATABASE_URL="file:dev.sqlite"

# Shopify (only needed when running without the Shopify CLI, e.g. in production)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,write_orders,write_products

# Outgoing e-mail (acknowledgements of receipt + merchant notifications).
# Any SMTP provider works (Postmark, Resend, Brevo, Mailgun, Amazon SES, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EU Compliance Suite <noreply@example.com>"

# Public contact shown in the app and legal pages
APP_SUPPORT_EMAIL=support@example.com
APP_OPERATOR_NAME="Felix Helleckes"
APP_OPERATOR_ADDRESS="Musterstraße 1, 50667 Köln, Deutschland"

# Secret used to hash IP addresses in the withdrawal log (any random string)
IP_HASH_SECRET=change-me

# Set to "true" to log e-mails to stdout instead of sending them
MAIL_DRY_RUN=false
