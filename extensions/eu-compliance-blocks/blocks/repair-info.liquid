{%- comment -%}
  App block: information on the right to repair (Art. 13(2a) Directive (EU) 2019/771 as amended by
  Directive (EU) 2024/1799 – choice between repair and replacement, 12-month extension after repair).
{%- endcomment -%}
<div class="eu-repair" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}<h3 class="eu-repair__heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
  <div class="eu-repair__text">
    {%- if block.settings.text != blank -%}{{ block.settings.text }}{%- else -%}<p>{{ 'repair.default_text' | t }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.repair_info.name",
  "target": "section",
  "stylesheet": "guarantee.css",
  "settings": [
    { "type": "paragraph", "content": "t:blocks.repair_info.info" },
    { "type": "text", "id": "heading", "label": "t:settings.heading" },
    { "type": "richtext", "id": "text", "label": "t:settings.text", "info": "t:settings.repair_text_info" }
  ]
}
{% endschema %}
