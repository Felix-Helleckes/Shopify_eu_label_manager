// Prisma schema – EU Compliance Suite
// SQLite in development and on a single Fly.io machine with a volume.
// Switch the provider to "postgresql" if you ever need multi-instance hosting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Shopify OAuth sessions (shape required by @shopify/shopify-app-session-storage-prisma).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/// One row per installed shop: contact data pulled from Shopify plus merchant settings.
model Shop {
  id                  String    @id @default(cuid())
  domain              String    @unique
  name                String?
  email               String?
  primaryDomain       String?
  currency            String?
  shopLocale          String?
  timezone            String?
  installedAt         DateTime  @default(now())
  uninstalledAt       DateTime?
  plan                String?

  // Withdrawal settings
  notifyMerchant      Boolean   @default(true)
  merchantEmail       String?
  replyToEmail        String?
  tagOrders           Boolean   @default(true)
  orderTag            String    @default("EU-Widerruf")
  ackLanguageMode     String    @default("storefront")
  extraAckText        String?

  // Guarantee / durability / repair settings
  guaranteeNoticeEnabled Boolean @default(true)
  durabilityLabelEnabled Boolean @default(true)
  repairInfoEnabled      Boolean @default(false)
  repairInfoText         String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// A withdrawal statement submitted through the storefront withdrawal function.
/// Records are legal evidence (Art. 11a(4)/(5) CRD, § 356a BGB) and are never
/// deleted while the shop is installed; personal data can be anonymised.
model Withdrawal {
  id                 String    @id @default(cuid())
  receiptNo          String    @unique
  shop               String
  locale             String    @default("de")

  consumerName       String
  contractRef        String
  contactEmail       String
  orderDate          String?
  details            String?

  orderId            String?
  orderName          String?
  orderMatched       Boolean   @default(false)
  orderEmailMatched  Boolean?
  orderCreatedAt     DateTime?

  submittedAt        DateTime  @default(now())
  contentHash        String
  ackSentAt          DateTime?
  ackError           String?
  merchantNotifiedAt DateTime?
  orderTaggedAt      DateTime?

  status             String    @default("received")
  merchantNote       String?
  anonymizedAt       DateTime?
  userAgent          String?
  ipHash             String?

  @@index([shop, submittedAt])
  @@index([shop, contactEmail])
  @@index([shop, status])
}

/// Minimal audit trail for compliance webhooks and other privacy-relevant events.
model AuditEvent {
  id        String   @id @default(cuid())
  shop      String
  type      String
  payload   String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
